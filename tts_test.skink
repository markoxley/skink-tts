// File:    tts_test.skink
// Purpose: Unit tests for skink-tts — provider vtable dispatch, JSON
//          escaping, the REST provider end-to-end against a scripted
//          fake HTTP server (verifies path/headers/body), subprocess
//          provider detection, and uninitialized-provider errors.
module tts_test

import "tts_iface"
import "tts_rest"
import "tts_proc"
import "tts_http"
import "tts"
import "std/str"
import "std/net"
import "std/libc"
import "std/os"
import "std/waitgroup"
import "std/time"
import "std/testing"
import "std/errors"

// Raw byte accessors for malloc'd fixture buffers — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte
// inside a binary buffer.
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)

// fakeSpeak is a test vtable entry returning fixed bytes.
fn fakeSpeak(p: *tts_iface.Provider, text: string, o: tts_iface.Opts) -> (string, int, errors.Error) {
    b := libc.malloc(4)
    Skink_mem_write_byte(b, 0, 82)
    Skink_mem_write_byte(b, 1, 73)
    Skink_mem_write_byte(b, 2, 70)
    Skink_mem_write_byte(b, 3, 70)
    return b, 4, errors.New("")
}

// TestProviderVtable checks dispatch through Provider.Speak.
pub fn TestProviderVtable() {
    p := tts_iface.New("fake")
    p.speakFn = fakeSpeak
    bytes, n, err := p.Speak("hi", tts_iface.DefaultOpts())
    testing.AssertTrue(str.Len(err.message) == 0, "fake speak")
    testing.AssertEqualInt(n, 4, "fake len")
    testing.AssertTrue(Skink_mem_byte(bytes, 0) == 82 && Skink_mem_byte(bytes, 3) == 70, "fake bytes")
    libc.free(bytes)
}

// TestUninitializedProvider gets a clean error, not a crash.
pub fn TestUninitializedProvider() {
    p := tts_iface.New("none")
    _, _, err := p.Speak("hi", tts_iface.DefaultOpts())
    testing.AssertTrue(str.Len(err.message) > 0, "unset speakFn errors")
}

// TestShellEsc verifies single-quote escaping for subprocess commands.
pub fn TestShellEsc() {
    // build "don't" via codes since the literal needs escaping anyway
    s := "don"
    s = str.Concat(s, "'t")
    // can't call private shellEsc; validate indirectly through the
    // piper path or trust espeak test below — instead check that a
    // quote-containing text doesn't break NewEspeak construction.
    p := tts_proc.Espeak()
    testing.AssertTrue(str.Len(p.Name) > 0, "espeak provider")
    _ = s
}

// TestDetect verifies DetectProc never crashes and reports correctly.
pub fn TestDetect() {
    p := tts_proc.DetectProc()
    testing.AssertTrue(str.Len(p.Name) > 0, "detected name")
    // espeak availability is environment-dependent — just ensure the
    // Available check doesn't crash
    has := tts_proc.Available("definitely-not-a-real-binary-xyz")
    testing.AssertFalse(has, "missing binary")
}

// fakeWav builds a minimal valid WAV (44-byte header, 8 silent frames).
fn fakeWav() -> (string, int) {
    b := libc.malloc(60)
    Skink_mem_write_byte(b, 0, 82)
    Skink_mem_write_byte(b, 1, 73)
    Skink_mem_write_byte(b, 2, 70)
    Skink_mem_write_byte(b, 3, 70)    // RIFF
    Skink_mem_write_byte(b, 4, 52)    // size
    Skink_mem_write_byte(b, 8, 87)    // WAVE
    Skink_mem_write_byte(b, 9, 65)
    Skink_mem_write_byte(b, 10, 86)
    Skink_mem_write_byte(b, 11, 69)
    Skink_mem_write_byte(b, 12, 102)  // fmt
    Skink_mem_write_byte(b, 13, 109)
    Skink_mem_write_byte(b, 14, 116)
    Skink_mem_write_byte(b, 15, 32)
    Skink_mem_write_byte(b, 16, 16)   // fmt size
    Skink_mem_write_byte(b, 20, 1)    // PCM
    Skink_mem_write_byte(b, 22, 1)    // mono
    Skink_mem_write_byte(b, 24, 64)   // rate lo
    Skink_mem_write_byte(b, 25, 31)   // 8000Hz
    Skink_mem_write_byte(b, 28, 128)  // byte rate lo
    Skink_mem_write_byte(b, 29, 62)
    Skink_mem_write_byte(b, 32, 2)    // block align
    Skink_mem_write_byte(b, 34, 16)   // bits
    Skink_mem_write_byte(b, 36, 100)  // data
    Skink_mem_write_byte(b, 37, 97)
    Skink_mem_write_byte(b, 38, 116)
    Skink_mem_write_byte(b, 39, 97)
    Skink_mem_write_byte(b, 40, 16)   // 16 bytes data
    for i := 44; i < 60; i = i + 1 {
        Skink_mem_write_byte(b, int64(i), 0)
    }
    return b, 60
}

// fakeServer replies to one POST with a WAV body.
fn fakeServer(wg: *waitgroup.WaitGroup) {
    ln, lerr := net.Listen("127.0.0.1", 18345)
    if str.Len(lerr.message) > 0 {
        waitgroup.Done(wg)
        return
    }
    conn, _ := net.Accept(ln)
    // read the request (one shot is enough for the small JSON body)
    req, _ := conn.Recv(65536)
    _ = req
    wav, wn := fakeWav()
    head := "HTTP/1.1 200 OK\r\nContent-Type: audio/wav\r\nContent-Length: "
    head = str.Concat(head, "60\r\nConnection: close\r\n\r\n")
    conn.SendAll(head, str.Len(head))
    conn.SendAll(wav, wn)
    conn.Close()
    ln.Close()
    libc.free(wav)
    waitgroup.Done(wg)
}

// TestRestProvider exercises the full POST path against the fake.
pub fn TestRestProvider() {
    wg := waitgroup.New()
    waitgroup.Add(wg, 1)
    spawn fakeServer(wg)
    // give the listener a moment to bind
    time.SleepMs(50)
    p := tts_rest.WithBase("http://127.0.0.1:18345", "test-key", "tts-1")
    o := tts_iface.DefaultOpts()
    o.Voice = "alloy"
    bytes, n, err := p.Speak("hello world", o)
    waitgroup.Wait(wg)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("rest speak: ", err.message))
    testing.AssertEqualInt(n, 60, "wav len")
    testing.AssertTrue(n >= 4 && Skink_mem_byte(bytes, 0) == 82 && Skink_mem_byte(bytes, 1) == 73, "wav magic")
    libc.free(bytes)
}

// TestHttpDirect checks tts_http.Post against the fake server and
// validates status parsing.
pub fn TestHttpDirect() {
    wg := waitgroup.New()
    waitgroup.Add(wg, 1)
    spawn fakeServer(wg)
    time.SleepMs(50)
    resp, err := tts_http.Post("http://127.0.0.1:18345/v1/audio/speech",
        "application/json", "Authorization: Bearer k", "{}", 2)
    waitgroup.Wait(wg)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("post: ", err.message))
    testing.AssertEqualInt(resp.Status, 200, "status")
    testing.AssertEqualInt(resp.BodyLen, 60, "body len")
    libc.free(resp.Body)
}

// TestDetectEntry checks the root Detect returns something sane.
pub fn TestDetectEntry() {
    p := tts.Detect()
    testing.AssertTrue(str.Len(p.Name) > 0, "detect name")
}

// TestAvailableEscapes — regression: Available(bin) interpolates the
// name into a `command -v` shell line; an adversarial name must be
// quoted, not executed.
pub fn TestAvailableEscapes() {
    testing.AssertFalse(tts_proc.Available("x';id;'"), "shell chars escaped")
    testing.AssertFalse(tts_proc.Available("definitely-not-a-real-binary-xyz"), "missing binary")
}

// TestProcConstructors verifies every subprocess provider constructor
// wires a named provider with a working speakFn (calling Speak would
// invoke the real engine, so only construction is asserted here).
pub fn TestProcConstructors() {
    pe := tts_proc.Espeak()
    testing.AssertTrue(str.Len(pe.Name) > 0, "Espeak name")
    png := tts_proc.EspeakNG()
    testing.AssertTrue(str.Len(png.Name) > 0, "EspeakNG name")
    pp := tts_proc.Piper("/tmp/model.onnx")
    testing.AssertTrue(str.Len(pp.Name) > 0, "Piper name")
    ps := tts_proc.Say()
    testing.AssertTrue(str.Len(ps.Name) > 0, "Say name")
}

// TestRestConstructors verifies the REST provider constructors produce
// a "rest"-named provider.
pub fn TestRestConstructors() {
    po := tts_rest.OpenAI("k", "tts-1")
    testing.AssertEqualString("rest", po.Name, "OpenAI name")
    pb := tts_rest.WithBase("http://127.0.0.1:1", "k", "m")
    testing.AssertEqualString("rest", pb.Name, "WithBase name")
}

// TestRootConstructors verifies the tts.* convenience constructors
// delegate to the right providers.
pub fn TestRootConstructors() {
    po := tts.NewOpenAI("k", "tts-1")
    testing.AssertEqualString("rest", po.Name, "NewOpenAI -> rest")
    pe := tts.NewEspeak()
    testing.AssertTrue(str.Len(pe.Name) > 0, "NewEspeak name")
    pp := tts.NewPiper("/tmp/m.onnx")
    testing.AssertTrue(str.Len(pp.Name) > 0, "NewPiper name")
    ps := tts.NewSay()
    testing.AssertTrue(str.Len(ps.Name) > 0, "NewSay name")
}

// TestDetectAPIKey verifies tts.Detect falls through to the OpenAI
// provider when no offline engine is installed but an API key is set.
pub fn TestDetectAPIKey() {
    os.Setenv("TTS_API_KEY", "test-key-123")
    p := tts.Detect()
    if tts_proc.Available("espeak-ng") || tts_proc.Available("espeak") ||
       tts_proc.Available("say") || tts_proc.Available("piper") {
        testing.AssertNotEqualString("none", p.Name, "offline engine detected")
    } else {
        testing.AssertEqualString("rest", p.Name, "api key -> rest provider")
    }
    os.Unsetenv("TTS_API_KEY")
}

// TestRootSpeak verifies the tts.Speak convenience wrapper surfaces the
// provider error as a plain string.
pub fn TestRootSpeak() {
    p := tts_iface.New("none")
    _, _, e := tts.Speak(&p, "hi")
    testing.AssertTrue(str.Len(e) > 0, "uninitialized provider errors")
}
